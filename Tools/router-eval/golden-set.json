 "cases": [
  {
   "id": "switch-cursor",
   "transcript": "switch to cursor",
   "expect": {
    "sequence": [
     {
      "tool": "open_app",
      "args": {
       "app": {
        "oneOf": [
         "Cursor",
         "com.todesktop.230313mzl4w4u92"
        ]
       }
      }
     }
    ]
   }
  },
  {
   "id": "github-tab",
   "transcript": "go to the github tab",
   "expect": {
    "sequence": [
     {
      "tool": "browser_switch_tab",
      "args": {
       "tab_id": {
        "eq": "chrome:1:101"
       }
      }
     }
    ]
   }
  },
  {
   "id": "stripe-new-tab",
   "transcript": "open stripe dashboard in a new tab",
   "expect": {
    "sequence": [
     {
      "tool": "browser_open_url",
      "args": {
       "url": {
        "urlHost": "dashboard.stripe.com"
       },
       "new_tab": {
        "absentOr": true
       }
      }
     }
    ]
   }
  },
  {
   "id": "close-this-tab",
   "transcript": "close this tab",
   "expect": {
    "sequence": [
     {
      "tool": "browser_close_tab",
      "args": {
       "tab_id": {
        "eq": "chrome:1:101"
       }
      }
     }
    ]
   }
  },
  {
   "id": "arrange-cut",
   "transcript": "put chrome on the left and the terminal on the right",
   "expect": {
    "sequence": [
     {
      "tool": "say"
     }
    ]
   }
  },
  {
   "id": "ask-claude-code",
   "transcript": "ask claude code why the build is failing",
   "expect": {
    "sequence": [
     {
      "tool": "type_text",
      "args": {
       "target": {
        "eq": "terminal"
       },
       "session_id": {
        "eq": "terminal:ttys001"
       },
       "payload": {
        "words": [
         "why the build is failing"
        ]
       }
      }
     }
    ],
    "forbid": [
     "submit"
    ],
    "policy": {
     "type_text": "run"
    }
   }
  },
  {
   "id": "ask-claude-code-send",
   "transcript": "ask claude code why the build is failing, send",
   "expect": {
    "sequence": [
     {
      "tool": "type_text",
      "args": {
       "target": {
        "eq": "terminal"
       },
       "session_id": {
        "eq": "terminal:ttys001"
       },
       "payload": {
        "words": [
         "why the build is failing"
        ]
       }
      }
     },
     {
      "tool": "submit",
      "args": {
       "send_phrase": {
        "words": [
         "send"
        ]
       }
      }
     }
    ],
    "policy": {
     "type_text": "run",
     "submit": "run"
    }
   }
  },
